# Copy to .env.bootstrap (git-ignored) and fill in. Used once by `npm run bootstrap`.
FIREBASE_PROJECT_ID=niat-elections-staging
FIREBASE_DATABASE_URL=https://niat-elections-staging-default-rtdb.asia-southeast1.firebasedatabase.app
# Path to the service-account JSON you downloaded (keep it OUTSIDE the project folder).
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/secrets/niat-elections-staging-sa.json
# Comma-separated, lowercase. Voter-admins can see who voted for whom (keep to 1–2 people).
ADMIN_EMAILS=you@gmail.com,organiser@gmail.com
VOTER_ADMIN_EMAILS=you@gmail.com
# Times are IST (YYYY-MM-DDTHH:mm)
CAMPAIGN_OPENS=2026-11-17T09:00
VOTING_OPENS=2026-11-19T09:00
VOTING_CLOSES=2026-11-20T17:00
SITE_CLOSES=2026-11-23T23:59
