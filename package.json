{
  "name": "niat-elections",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-niat-elections-rules-test \"vitest run --config vitest.rules.config.mts\"",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-niat-elections",
    "seed": "tsx --env-file=.env.seed scripts/seed/index.ts --direct-tallies",
    "seed:reset": "tsx --env-file=.env.seed scripts/seed/reset.ts",
    "format": "prettier --write .",
    "functions:build": "npm --prefix functions run build",
    "emulators:persist": "npm run functions:build && firebase emulators:start --project demo-niat-elections --import=.emulator-data --export-on-exit=.emulator-data",
    "test:rules:live": "vitest run --config vitest.rules.config.mts",
    "bootstrap": "tsx --env-file=.env.bootstrap scripts/seed/bootstrap-prod.ts --confirm",
    "prebuild": "cd functions && node copy-schema.mjs",
    "ops:import": "tsx --env-file=.env.bootstrap scripts/ops/import-sheet.ts",
    "ops:window": "tsx --env-file=.env.bootstrap scripts/ops/set-window.ts",
    "ops:sync": "tsx --env-file=.env.bootstrap scripts/ops/sync-real.ts",
    "ops:verify": "tsx --env-file=.env.bootstrap scripts/ops/verify.ts",
    "env:real": "node -e \"require('fs').copyFileSync('.env.local.real','.env.local');console.log('Using REAL Firebase — rebuild to apply')\"",
    "env:test": "node -e \"require('fs').copyFileSync('.env.local.emulator','.env.local');console.log('Using TEST emulators — rebuild to apply')\""
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "aws4fetch": "^1.0.20",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.6.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  }
}
