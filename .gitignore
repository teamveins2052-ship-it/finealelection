# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow non-secret env templates
!.env.example
!.env.seed

# firebase
.emulator-data/
*-debug.log
firebase-debug.*.log

# never commit PII or credentials
*.xlsx
service-account*.json

.next-build/

# bootstrap credentials
!.env.bootstrap.example
!.env.staging.example

# local production builds (any dist dir)
/.next-*/
functions/node_modules
functions/lib

# more credentials / personal data patterns
*adminsdk*.json
*serviceAccount*.json
*.csv
.claude/settings.local.json
playwright-report/
test-results/

# NOT ours: copy of dontlookup.app (3D models, audio, art, code) — never publish
public/hero.html
public/assets/
public/election_rally.js
components/public/dont-look-up-hero.tsx
