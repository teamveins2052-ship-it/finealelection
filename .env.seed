# Emulator-only seed config (no secrets). The demo- project ID can't reach real Firebase.
FIREBASE_PROJECT_ID=demo-niat-elections
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-niat-elections-default-rtdb
SEED_MEDIA_BASE_URL=http://localhost:3100/seed-media/
