# Real Firebase (staging). Copy over .env.local when you switch from emulators.
# Keep your emulator copy as .env.local.emulator so you can switch back.

# From Firebase console → Project settings → General → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=niat-elections-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=niat-elections-staging
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://niat-elections-staging-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.yourdomain.com/

# MUST be false (or removed) for a real project — otherwise the app talks to the emulators.
NEXT_PUBLIC_USE_EMULATORS=false
# Do NOT set FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST here.

# App Check (optional until 17 Nov): reCAPTCHA Enterprise site key
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# No service-account key needed — student lookup runs in Cloud Functions.

# Optional services (leave blank to keep the local fallbacks)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=niat-elections-media
R2_PUBLIC_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
