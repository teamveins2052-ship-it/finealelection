# Copy to functions/.env.<project-id> (e.g. functions/.env.niat-elections-staging). Git-ignored.
# Secrets (MFA_ENCRYPTION_KEY) go in Secret Manager instead: firebase functions:secrets:set ...
DATABASE_URL=https://niat-elections-staging-default-rtdb.asia-southeast1.firebasedatabase.app
APP_URL=http://localhost:3100
# First-admin setup (no key file needed): the one Google account allowed to press "Set up this election"
BOOTSTRAP_ADMIN_EMAIL=you@gmail.com
# Election window (IST) used by that setup
CAMPAIGN_OPENS=2026-11-17T09:00
VOTING_OPENS=2026-11-19T09:00
VOTING_CLOSES=2026-11-20T17:00
SITE_CLOSES=2026-11-23T23:59
# Leave unset (off) until App Check shows mostly "verified" requests, then set to true.
# ENFORCE_APP_CHECK=true
# TURNSTILE_SECRET=

# ---- Brevo (welcome, sticker, announcements, reminders) — sign-in links come from Firebase ----
# Account 1 (yours). Each account needs its own verified sender in Brevo → Senders & IP.
BREVO_API_KEY=
EMAIL_FROM=
# Account 2 (your friend's). Used automatically when account 1 reaches today's limit.
BREVO_API_KEY_2=
EMAIL_FROM_2=
# Account 3 (third person's). Used when accounts 1 and 2 are both at today's limit.
BREVO_API_KEY_3=
EMAIL_FROM_3=
# Per-account daily stop (Brevo free = 300/day; 280 leaves a safety margin)
# Optional: where replies go (e.g. your Gmail if the sender domain has no mailbox)
EMAIL_REPLY_TO=
BREVO_DAILY_CAP=280
