# ---- Next.js (copy to .env.local) ----
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-niat-elections.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-niat-elections
NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-niat-elections-default-rtdb
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:3100/seed-media/
NEXT_PUBLIC_USE_EMULATORS=true

# ---- Server-only (Cloudflare: `npx wrangler secret put NAME`) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=niat-elections-media
R2_PUBLIC_URL=
FIREBASE_SA_CLIENT_EMAIL=
FIREBASE_SA_PRIVATE_KEY=

# ---- functions/.env (secrets via `firebase functions:secrets:set`) ----
# BREVO_API_KEY=
# EMAIL_FROM=elections@<domain>
# APP_URL=

# ---- Local emulators for server-side API routes (remove in staging/prod) ----
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
