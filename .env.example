# =====================================================================================
#  NIAT Elections '26 — environment template (NO real values; safe to commit)
#  Copy to .env.local (local site) — same names go into Vercel → Settings → Environment Variables.
#  After deploying, open /api/health: it must say "healthy": true.
# =====================================================================================

# --- 1. SUPABASE (browser, public) · Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- 2. SUPABASE (server, SECRET)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
#   Database → Connect → "Transaction pooler" (port 6543) for Vercel; "Session pooler" (5432) locally.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- 3. 2-STEP ENCRYPTION KEY — SECRET · 32 random bytes, base64. Never change once in use.
#        node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# --- 4. SITE ADDRESS — local: http://localhost:3100 · live: https://<your-site>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3100
APP_URL=http://localhost:3100

# --- 5. BREVO EMAILS — SECRET · also sends the sign-in links · up to 5 accounts (_2 … _5)
BREVO_API_KEY=
EMAIL_FROM=elections@your-domain
BREVO_API_KEY_2=
EMAIL_FROM_2=
BREVO_API_KEY_3=
EMAIL_FROM_3=
EMAIL_REPLY_TO=
BREVO_DAILY_CAP=280

# --- 6. OTHER
BOOTSTRAP_ADMIN_EMAIL=
CRON_SECRET=

# --- 7. OPTIONAL — leave empty unless needed
# Bot protection on the login lookup (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Password sign-in box for test accounts — NEVER "true" on the live site
NEXT_PUBLIC_TEST_LOGIN=
# Upload rate limits on the edge (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
