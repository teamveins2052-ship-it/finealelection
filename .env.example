# =====================================================================================
#  NIAT Elections '26 — environment template (NO real values; safe to commit)
#  Copy to .env.local and fill in. Same numbered order as .env.vercel / .env.local.real.
#  Local test mode (emulators): use .env.local.emulator instead (npm run env:test).
# =====================================================================================

# --- 1. FIREBASE WEB APP — used in the browser (public) · Firebase → Project settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_EMULATORS=false

# --- 2. FIREBASE SERVER ACCESS — SECRET · base64 of the service-account key JSON (one line)
FIREBASE_PROJECT_ID=your-project
FIREBASE_SERVICE_ACCOUNT_B64=
DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
USE_FIREBASE_EMULATORS=false

# --- 3. 2-STEP ENCRYPTION KEY — SECRET · 32 random bytes, base64. Never change once in use.
#        node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# --- 4. SITE ADDRESS — local: http://localhost:3100 · live: https://<your-site>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3100
APP_URL=http://localhost:3100

# --- 5. BREVO EMAILS — SECRET · up to 5 accounts (_2 … _5), switched at the daily cap
BREVO_API_KEY=
EMAIL_FROM=elections@your-domain
BREVO_API_KEY_2=
EMAIL_FROM_2=
BREVO_API_KEY_3=
EMAIL_FROM_3=
EMAIL_REPLY_TO=
BREVO_DAILY_CAP=280

# --- 6. OTHER
BOOTSTRAP_ADMIN_EMAIL=
CRON_SECRET=

# --- 7. OPTIONAL — not used yet; leave empty
# Bot protection (Cloudflare Turnstile) and App Check (reCAPTCHA Enterprise)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
ENFORCE_APP_CHECK=
# Nominee photo/video uploads (Cloudflare R2) + upload rate limits (Upstash Redis)
NEXT_PUBLIC_MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
